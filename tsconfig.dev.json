{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"]
    },
    "moduleResolution": "node"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "demo/src/**/*.ts",
    "demo/src/**/*.d.ts",
    "demo/src/**/*.tsx",
    "demo/*.ts",
    "demo/*.html",
  ]
}
